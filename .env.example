# Copy to .env.local and fill in. Never commit .env.local.

# Vaani Labs (add any other variables the Vaani docs require, verified in Milestone 4)
VAANI_API_KEY=
VAANI_WEBHOOK_SECRET=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# HubSpot
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_NAME="Aangan Enquiries"

# Google Calendar (service account JSON, base64 encoded)
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# App
APP_BASE_URL=http://localhost:3000

# Booking config (placeholders, replace with real values)
CONSULTATION_MINUTES=45
BOOKABLE_START_HOUR=10
BOOKABLE_END_HOUR=19
BOOKABLE_DAYS=Mon,Tue,Wed,Thu,Fri,Sat
OFFICE_TZ=Asia/Kolkata

# Qualification config flags (see PROGRESS.md, confirm with Nikhil)
QUALIFY_FAIL_POLICY=any_clear_fail
TIMELINE_FAIL_UNDER_WEEKS=6
TIMELINE_PASS_FROM_WEEKS=10

# Use mock Vaani adapter in tests and local dev
VAANI_ADAPTER=mock
